---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = await getCollection('work', (e) => import.meta.env.DEV || !e.data.draft);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="pt-10 sm:pt-16">
    <a href="/work" class="text-sm text-muted no-underline hover:text-ink">← All work</a>
    <p class="eyebrow mt-6">{entry.data.period}{entry.data.draft && ' · draft (not published)'}</p>
    <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">{entry.data.title}</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">{entry.data.summary}</p>
    <div class="prose mt-10 max-w-2xl prose-headings:tracking-tight">
      <Content />
    </div>
  </article>
</Base>
