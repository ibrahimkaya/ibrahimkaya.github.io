---
interface Props { value: string; unit: string; label: string }
const { value, unit, label } = Astro.props;
---
<div class="rounded-xl border border-line bg-surface p-5">
  <div class="flex items-baseline gap-2">
    <span class="num text-3xl font-semibold tracking-tight">{value}</span>
    <span class="text-sm font-medium text-accent">{unit}</span>
  </div>
  <p class="mt-1.5 text-sm text-muted">{label}</p>
</div>
