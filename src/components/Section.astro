---
interface Props { eyebrow: string; title: string; intro?: string; id?: string }
const { eyebrow, title, intro, id } = Astro.props;
---
<section id={id} class="mt-20 scroll-mt-8">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-[1.65rem]">{title}</h2>
  {intro && <p class="mt-3 max-w-2xl text-muted">{intro}</p>}
  <div class="mt-8"><slot /></div>
</section>
